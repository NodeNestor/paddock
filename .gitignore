# Rust
/target/

# Compiled kernel packs (built by packs/*/build.ps1, not committed)
packs/*/build/
**/*.rs.bk

# Our own pdfium build: the static libraries are ~25 MB artifacts, produced by
# packs/pdfium/build/ and rebuilt from source, so they stay out of git. What IS
# tracked is everything needed to reproduce them and to ship honest notices:
# the VERSION pin, the build recipe, and the
# licence set the build extracts from the pdfium checkout - 204 KB of text that
# THIRD-PARTY-NOTICES is generated from, and that a fresh clone must not need a
# 15-minute Chromium build to regenerate.
packs/pdfium/*
!packs/pdfium/VERSION
!packs/pdfium/prebuilt.json
!packs/pdfium/build/
!packs/pdfium/licenses/

# NVIDIA's redistributable CUDA libraries (~655 MB/platform, cuBLASLt alone is
# 458 MB), staged out of tree from NVIDIA's own redist index at the release the
# VERSION pin names. Never bundled in the app package: the manager fetches them
# per box, hardware-matched, so a machine we cannot serve downloads nothing.
# The VERSION pin is tracked.
packs/cuda-runtime/*
!packs/cuda-runtime/VERSION

# Assembled portable packages (the portable packager)
dist/

# A llama.cpp build, fetched out of tree (~600 MB of DLLs). The greedy-parity
# tests in paddock-bench look for llama-server here and skip when it is absent.
# Nothing about it is tracked: the reference is always a CURRENT llama.cpp
# release, so a pinned version in git would only ever be out of date.
/vendor/llamacpp/*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# machine-local model symlink (remote bring-up convenience)
/models

# Built Studio output (generated by studio/ vite build; embedded by the manager)
crates/paddock-manager/static/

# runtime state from a server launched in the repo dir
paddock.db*

# Local machine dev config (machine-specific paths)
paddock.toml

crates/paddock-runner/tests/python/__pycache__/

# manager runtime logs (paddock writes these next to the data dir when run
# from the repo root)
logs/

# Throwaway ssh keypair for the test runner.
.testbox/
