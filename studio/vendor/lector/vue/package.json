{
  "name": "@truespar/lector-vue",
  "version": "0.1.0",
  "description": "Vue 3 components and composables for Lector PDF renderer",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/truespar/lector.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@truespar/lector-core": "file:../core",
    "@truespar/lector-utils": "file:../utils"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vue": "^3.5.16"
  }
}
