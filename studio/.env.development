# Dev only (loaded by `vite dev`, NOT by `vite build`). The GPU telemetry
# WebSocket connects straight to the paddock MANAGER here (device telemetry
# lives there after the manager/runner split) because Vite's proxy can't
# reliably upgrade a WS next to its HMR socket. In production the manager
# serves the Studio same-origin, so this is unset and the WS uses the page
# host automatically.
#
# wss, not ws: the manager defaults to TLS. Point it at a plain
# http manager by overriding this to ws://localhost:11500.
VITE_API_WS=wss://localhost:11500
